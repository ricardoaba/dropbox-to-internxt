# Copia este archivo a .env y rellena los valores. NO subas .env a git.

# --- Cuenta Internxt (obligatorio) ---
INXT_USER=tu@email.com
INXT_PASSWORD=tu-contraseña-internxt
# Si tienes 2FA, lo más cómodo es el secreto TOTP (el que escaneaste en la app de autenticación):
INXT_OTPTOKEN=
# Alternativa: un código 2FA de un solo uso (caduca en segundos, solo para un arranque puntual)
INXT_TWOFACTORCODE=

# --- Servidor WebDAV ---
WEBDAV_PORT=3005
WEBDAV_PROTOCOL=http
WEBDAV_CUSTOM_AUTH=true
WEBDAV_USERNAME=webdav
WEBDAV_PASSWORD=cambia-esta-contraseña
WEBDAV_DELETE_FILES_PERMANENTLY=false
WEBDAV_KEEPALIVE_ENABLED=true
INXT_SQLITE_JOURNAL_MODE=WAL

# --- Script de ejemplo (cmd/webdav-demo) ---
INXT_WEBDAV_URL=http://127.0.0.1:3005
INXT_WEBDAV_USER=webdav
INXT_WEBDAV_PASS=cambia-esta-contraseña

# --- Migración Dropbox -> Internxt (scripts/migrar-lote.sh) ---
DROPBOX_DIR=$HOME/Dropbox
MIGRATE_DST=/Dropbox
MIGRATE_BATCH_FILES=200
MIGRATE_BATCH_BYTES=2G
MIGRATE_VERIFY=hash
MIGRATE_PARALLEL=2
